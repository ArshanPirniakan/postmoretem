# Copy to .env and adjust as needed. All values have safe local-first defaults.

POSTMORTEM_ENV=development
POSTMORTEM_DEBUG=false

# Storage (zero-cost local-first)
POSTMORTEM_DATA_DIR=./data
POSTMORTEM_ARTIFACTS_DIR=./artifacts
POSTMORTEM_DATABASE_URL=sqlite:///./data/postmortem.db

# Upload limits
POSTMORTEM_MAX_UPLOAD_BYTES=26214400
POSTMORTEM_MAX_UPLOAD_ROWS=200000

# Feature / model config
POSTMORTEM_TEXT_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
POSTMORTEM_TEXT_EMBEDDING_DIM=384
POSTMORTEM_SEED=42

# Training safety
POSTMORTEM_MAX_EPOCHS=60
POSTMORTEM_MAX_TRAIN_SECONDS=900
POSTMORTEM_MAX_CONCURRENT_JOBS=1

# Uncertainty
POSTMORTEM_MC_PASSES=30

# API
POSTMORTEM_CORS_ORIGINS=http://localhost:8501

# UI (used by ui/streamlit_app.py)
POSTMORTEM_API_URL=http://localhost:8000
